<AnchorPane fx:id="rootPane" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="720.0" prefWidth="1280.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1">
   <children>
      <ImageView fitHeight="720.0" fitWidth="1280.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@../../res/images/test_rainforest.jpg" />
         </image>
      </ImageView>
      <AnchorPane fx:id="buttonPane" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="720.0" prefWidth="1280.0">
         <children>
            <Button layoutX="42.0" layoutY="165.0" mnemonicParsing="false" onAction="#handleColourChoice" prefHeight="70.0" prefWidth="200.0" styleClass="color-button, green-button" text="Green" />
            
            <Button layoutX="42.0" layoutY="360.0" mnemonicParsing="false" onAction="#handleColourChoice" prefHeight="70.0" prefWidth="200.0" styleClass="color-button, blue-button" text="Blue" />
            
            <Button layoutX="242.0" layoutY="265.0" mnemonicParsing="false" onAction="#handleColourChoice" prefHeight="70.0" prefWidth="200.0" styleClass="color-button, yellow-button" text="Yellow" />
            
            <Button layoutX="242.0" layoutY="459.0" mnemonicParsing="false" onAction="#handleColourChoice" prefHeight="70.0" prefWidth="200.0" styleClass="color-button, pink-button" text="Pink" />
            
