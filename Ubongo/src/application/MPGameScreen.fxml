         </font>
      </Label>
      <Label fx:id="timerLabel" alignment="CENTER" contentDisplay="TOP" layoutX="427.0" layoutY="48.0" prefHeight="66.0" prefWidth="458.0" text="Timer" textFill="#05facd">
